+            expiries_query = text("""
+                SELECT DISTINCT expiry_date
+                FROM bhavcopy_fo
+                WHERE ticker_symb = :symbol
+            """)
+            exp_result = db.execute(expiries_query, {"symbol": symbol}).fetchall()
+            valid_exp_dates = [r[0] for r in exp_result]
+            if valid_exp_dates:

+                const fmtChg = (v) => v ? `<span style="color:${v>=0?'#60a5fa':'#f87171'}">${v>0?'+':''}${v.toLocaleString()}</span>` : '-';
+
+                htmlBuffer += `<tr style="border-bottom: 1px solid #333;">

+
+            if not row_date:
+                continue
+
+            record = {
+                'date': row_date,
+                'open_value': cls._clean_numeric(cls._get_val(row, ['Open'])),
+                'high_value': cls._clean_numeric(cls._get_val(row, ['High'])),

+function downloadDividendsCSV() {
+    const table = document.getElementById('div-actions-table');
+    if (!table) {
+        alert("No table found to export.");
+        return;
+    }
+
+    const searchInput = document.getElementById('div-symbol-search');
+    const searchFilter = searchInput ? searchInput.value.toUpperCase() : '';
+    let filename = searchFilter ? `${searchFilter}_dividend_history.csv` : 'dividend_history.csv';
+
+    const csvRows = [];
+    const headers = [];
+
+    // Extract headers
+    const theadRow = table.querySelector('thead tr');
+    if (theadRow) {
+        theadRow.querySelectorAll('th').forEach(th => {
+            let text = th.innerText.trim();
+            // Remove sort arrows if they exist
+            text = text.replace(/▼|▲/g, '').trim();
+            headers.push(text);
+        });
+        csvRows.push(headers.join(','));
+    }
+
+    // Extract rows from tbody
+    const tbodyRows = table.querySelectorAll('tbody tr');
+    if (!tbodyRows || tbodyRows.length === 0 || tbodyRows[0].innerText.includes('No data')) {
+         alert("No data available to export.");
+         return;
+    }
+
+    tbodyRows.forEach(tr => {
+        const values = [];
+        tr.querySelectorAll('td').forEach(td => {
+            // Get plain text to ignore HTML badges or styling
+            let val = td.innerText.trim();
+            if (val) {
+                // Escape quotes
+                val = val.replace(/"/g, '""');
+                // Quote field if it contains comma, newline, or quotes
+                if (val.search(/("|,|\n)/g) >= 0) {
+                    val = `"${val}"`;
+                }
+            }
+            values.push(val);
+        });
+        csvRows.push(values.join(','));
+    });
+
+    const csvData = new Blob(['\uFEFF' + csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
+    const csvUrl = URL.createObjectURL(csvData);
+    const hiddenElement = document.createElement('a');
+    hiddenElement.href = csvUrl;
+    hiddenElement.target = '_blank';
+    hiddenElement.download = filename;
+    hiddenElement.click();
+}

+
+    def _select_best_model(self):
+        """
+        Directly explicitly select the preferred model.
+        Bypasses dynamic list filtering due to volatile google-genai SDK schemas causing empty lists.
+        """
+        try:
+            # Explicit preferences from the user
+            preferences = [
+                'gemini-1.5-flash',
+                'gemini-2.0-flash',
+                'gemini-1.5-flash-8b'
+            ]

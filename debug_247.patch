+                    <td style="color: #ccc; ${bgStyle}">${c.oi > 0 ? (c.oi).toLocaleString() : '-'}</td>
+                    <td style="color: #e6a23c; ${bgStyle}">${fmtVol(c.iv)}</td>
+                    <td style="color: #ccc; ${bgStyle}">${fmtPct(c.pct_change)}</td>
+                    <td style="font-weight: bold; color: #fff; border-right: 2px solid #555; ${bgStyle}">${c.price > 0 ? c.price.toFixed(2) : '-'}</td>
+
+                    <td style="font-weight: bold; background: ${isATM ? '#444' : '#2a2a2a'}; color: #ffcc00; font-size: 14px;">${row.strike}</td>
+
+                    <td style="font-weight: bold; color: #fff; border-left: 2px solid #555; ${bgStyle}">${p.price > 0 ? p.price.toFixed(2) : '-'}</td>
+                    <td style="color: #ccc; ${bgStyle}">${fmtPct(p.pct_change)}</td>
+                    <td style="color: #e6a23c; ${bgStyle}">${fmtVol(p.iv)}</td>
+                    <td style="color: #ccc; ${bgStyle}">${p.oi > 0 ? (p.oi).toLocaleString() : '-'}</td>
+                    <td style="color: #ccc; ${bgStyle}">${fmtChg(p.chg_oi)}</td>
+                    <td style="color: #ccc; ${bgStyle}">${p.vol > 0 ? (p.vol).toLocaleString() : '-'}</td>

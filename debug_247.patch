+            if (!e.target.closest('.custom-dropdown')) {
+                document.querySelectorAll('.custom-dropdown').forEach(el => el.classList.remove('open'));
+            }
+        });
+
+        function switchClientTab(tabId) {
+            document.querySelectorAll('.client-tab-content').forEach(el => el.classList.remove('active'));
+            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
+
+            document.getElementById('tab-' + tabId).classList.add('active');
+            document.getElementById('btn-tab-' + tabId).classList.add('active');
+
+            // Show/hide right sidebar depending on tab
+            const sidebar = document.getElementById('sidebar');
+            if (tabId === 'ai') {
+                sidebar.style.display = 'flex';
+            } else {
+                sidebar.style.display = 'none';
+            }
+
+            // Trigger resizes for charts when tab changes
+            setTimeout(() => { window.dispatchEvent(new Event('resize')); }, 100);
+
+            // Trigger respective initialization if not already loaded
+            if (tabId === 'dividend') {
+                const tbody = document.getElementById('ss-div-tbody');
+                if (!tbody || tbody.innerHTML.includes('Click \'Refresh Data\' to load')) {
+                    if (typeof loadSSDividends === 'function') loadSSDividends();
+                }
+            } else if (tabId === 'oi') {
+                if(!window.pcrChartInstance && typeof loadOptionsAnalysis === 'function') loadOptionsAnalysis();
+                if (typeof WorkbookManager !== 'undefined' && WorkbookManager.modules['oi_analysis']) {
+                    const oiContainer = document.getElementById('oi-tool-container');
+                    if (oiContainer && !oiContainer.dataset.rendered) {
+                        WorkbookManager.modules['oi_analysis'].render(oiContainer);
+                        WorkbookManager.modules['oi_analysis'].loadAggregatedData();
+                        oiContainer.dataset.rendered = 'true';
+                    }
+                }
+            } else if (tabId === 'rollover') {
+                if (typeof WorkbookManager !== 'undefined' && WorkbookManager.modules['rollover']) {
+                    const rolloverContainer = document.getElementById('deriv-tab-rollover');
+                    if (rolloverContainer && !rolloverContainer.dataset.rendered) {
+                        WorkbookManager.modules['rollover'].render(rolloverContainer);
+                        WorkbookManager.modules['rollover'].loadAggregatedData();
+                        rolloverContainer.dataset.rendered = 'true';
+                    }
+                } else if (typeof loadRolloverData === 'function') {
+                    loadRolloverData();
+                }
+            } else if (tabId === 'mwpl') {
+                const tbody = document.getElementById('mwpl-analysis-body');
+                if(!tbody || tbody.innerHTML.includes('Click "Refresh MWPL Data" to load.')) {
+                    if (typeof loadMWPLAnalysis === 'function') loadMWPLAnalysis();
+                }
+            } else if (tabId === 'fii') {
+                const tbody = document.getElementById('fii-smart-money-history-body');
+                if(!tbody || tbody.innerHTML.includes('Loading history...')) {
+                    if (typeof loadFiiAnalysis === 'function') loadFiiAnalysis();
+                    if(typeof loadFiiTrendChart === 'function') loadFiiTrendChart();
+                }
+            }
+        }
+
+        function quickSend(text) {
+            document.getElementById('chat-input').value = text;
+            sendMessage();
+        }
+
+        function prefillPrompt(text) {
+            const input = document.getElementById('chat-input');
+            input.value = text;
+            input.focus();
+
+            // Add a conversational tip from the AI
+            addAIMessage(`Got it. Please specify the stock, date range, or any specific filters you'd like to apply for the ${text.replace(' for: ', '')}.`);
+        }
+
+        function setThinkingState(message) {
+            let thinkingDiv = document.getElementById('ai-thinking');
+            if (!thinkingDiv) {
+                const msgs = document.getElementById('chat-messages');
+                thinkingDiv = document.createElement('div');
+                thinkingDiv.id = 'ai-thinking';
+                thinkingDiv.className = 'message msg-ai';
+                thinkingDiv.style.opacity = '0.7';
+                thinkingDiv.style.fontStyle = 'italic';
+                thinkingDiv.style.fontSize = '0.9em';
+                msgs.appendChild(thinkingDiv);
+            }
+            thinkingDiv.innerHTML = `<i class="fas fa-spinner fa-spin" style="margin-right: 5px;"></i> ${message}`;
+
+            const msgs = document.getElementById('chat-messages');
+            msgs.scrollTop = msgs.scrollHeight;
+        }
+
+        function clearThinkingState() {
+            const thinkingDiv = document.getElementById('ai-thinking');
+            if (thinkingDiv) {
+                thinkingDiv.remove();
+            }
+        }
+
+        function sendMessage() {
+            const input = document.getElementById('chat-input');
+            const cmd = input.value.trim();
+            if (!cmd) return;
+
+            // Use hardcoded keys or try to get from session if available locally
+            // In production, keys should ideally be securely handled backend-side
+            const groqKey = localStorage.getItem('GROQ_API_KEY') || "";
+            const openrouterKey = localStorage.getItem('OPENROUTER_API_KEY') || "";
+            const googleKey = localStorage.getItem('GOOGLE_API_KEY') || "";
+
+            addUserMessage(cmd);
+            input.value = '';
+            input.disabled = true;
+
+            if (ws && ws.readyState === WebSocket.OPEN) {
+                ws.send(JSON.stringify({
+                    command: cmd,
+                    keys: { groq: groqKey, openrouter: openrouterKey, google: googleKey },
+                    session_id: "chat_user_01",
+                    history: chatHistory.slice(-10) // Send last 10 messages for context
+                }));
+                logMessage("[SYSTEM]", `Sent command: ${cmd}`, "#aaa");
+            } else {
+                addAIMessage("Connection not available. Trying to reconnect...");
+                connectWS();
+                input.disabled = false;
+            }
+        }
+
+        // Widget Renderer Logic
+        async function renderWidget(widgetData) {
+            logMessage("[WIDGET]", `Rendering ${widgetData.widget}`, "#3b82f6");
+
+            // Strictly NO AI intro or summary text, just render the widget
+            let html = ``;
+
+            if (widgetData.widget === "error") {
+                html += `<div style="color:#ff4d4d; border-left: 3px solid #ff4d4d; padding-left: 10px;">${widgetData.summary || "Unknown extraction error."}</div>`;
+            } else if (widgetData.widget === "dividend_table") {
+                // Fetch the deterministic data from backend
+                try {
+                    const params = new URLSearchParams();
+                    if(widgetData.symbols) widgetData.symbols.forEach(s => params.append("symbol", s));
+                    if(widgetData.months) widgetData.months.forEach(m => params.append("month", m));
+                    if(widgetData.upcoming) params.append("upcoming", "true");
+
+                    const res = await fetch(`/api/chat-widgets/dividend?${params.toString()}`);
+                    if (!res.ok) {
+                         throw new Error(`Backend returned status ${res.status}`);
+                    }
+                    const data = await res.json();
+
+                    if (!data || data.length === 0) {
+                        html += `<div>No dividend records found matching those parameters.</div>`;
+                    } else {
+                        tableCounter++;
+                        const tableId = `tbl-${tableCounter}`;
+
+                        // Store summary in chat history so the AI knows what data was returned
+                        const dataSummary = JSON.stringify(data.slice(0, 15)); // Keep it concise
+                        chatHistory.push({ role: 'assistant', content: `[DATA_WIDGET_RETURNED: ${dataSummary}]` });
+
+                        html += `
+                        <div class="excel-table-wrapper">
+                            <div class="table-actions" style="gap: 10px;">
+                                <button onclick="analyzeWidgetData('${tableId}')" style="background: #3b82f6;"><i class="fas fa-brain"></i> Analyze</button>
+                                <button onclick="exportXLSX('${tableId}', 'Dividend_Data')"><i class="fas fa-file-excel"></i> Export XLSX</button>
+                            </div>
+                            <table class="excel-table" id="${tableId}">
+                                <thead>
+                                    <tr>
+                                        ${Object.keys(data[0]).map(k => `<th>${k}</th>`).join('')}
+                                    </tr>
+                                </thead>
+                                <tbody>
+                                    ${data.map((row, idx) => `
+                                        <tr class="row-${tableId}" style="${idx >= 10 ? 'display:none;' : ''}">
+                                            ${Object.values(row).map(v => `<td>${v !== null ? v : '-'}</td>`).join('')}
+                                        </tr>
+                                    `).join('')}
+                                </tbody>
+                            </table>
+                            ${data.length > 10 ? `
+                            <div style="text-align: center; padding: 10px; background: var(--chat-ai); border: 1px solid var(--border-color); border-top: none; border-radius: 0 0 8px 8px;">
+                                <button onclick="toggleRows('${tableId}')" style="background: transparent; color: #4caf50; border: 1px solid #4caf50; padding: 5px 15px; border-radius: 15px; cursor: pointer; font-size: 13px; font-weight: bold;">Show More (${data.length - 10})</button>
+                            </div>` : ''}
+                        </div>`;
+
+                        // Store raw data in window for export
+                        window[`data_${tableId}`] = data;
+                    }
+
+                } catch(e) {
+                    html += `<div style="color:red;">Error fetching widget data: ${e.message}</div>`;
+                }
+            }
+
+            clearThinkingState();
+            addAIMessage(html, true);
+            document.getElementById('chat-input').disabled = false;
+        }
+
+        function toggleRows(tableId) {
+            const rows = document.querySelectorAll(`.row-${tableId}`);
+            let isHidden = false;
+            rows.forEach((r, idx) => {
+                if (idx >= 10) {
+                    if (r.style.display === 'none') {
+                        r.style.display = 'table-row';
+                        isHidden = true;
+                    } else {
+                        r.style.display = 'none';
+                    }
+                }
+            });
+
+            const btn = event.target;
+            if (isHidden) {
+                btn.innerText = 'Show Less';
+            } else {
+                btn.innerText = `Show More (${rows.length - 10})`;
+            }
+        }
+
+        function analyzeWidgetData(tableId) {
+            const data = window[`data_${tableId}`];
+            if (!data) return;
+
+            const groqKey = localStorage.getItem('GROQ_API_KEY') || "";
+            const openrouterKey = localStorage.getItem('OPENROUTER_API_KEY') || "";
+            const googleKey = localStorage.getItem('GOOGLE_API_KEY') || "";
+
+            const cmd = "ANALYZE_WIDGET_DATA|" + JSON.stringify(data.slice(0, 50)); // Send up to 50 rows
+
+            addUserMessage("Please analyze the data in the table above.");
+            document.getElementById('chat-input').disabled = true;
+
+            if (ws && ws.readyState === WebSocket.OPEN) {
+                ws.send(JSON.stringify({
+                    command: cmd,
+                    keys: { groq: groqKey, openrouter: openrouterKey, google: googleKey },
+                    session_id: "chat_user_01",
+                    history: chatHistory.slice(-10)
+                }));
+                logMessage("[SYSTEM]", `Sent direct widget analysis request.`, "#aaa");
+            }
+        }
+
+        function exportXLSX(tableId, filename) {
+            const data = window[`data_${tableId}`];
+            if (!data) return;
+
+            const ws = XLSX.utils.json_to_sheet(data);
+            const wb = XLSX.utils.book_new();
+            XLSX.utils.book_append_sheet(wb, ws, "Data");
+            XLSX.writeFile(wb, `${filename}.xlsx`);
+        }
+
+        // Handle streaming text explicitly
+        let activeStreamMessage = null;
+
+        const originalOnMessage = ws ? ws.onmessage : null;
+        function updateWebSocketHandler() {
+            if (!ws) return;
+            ws.onmessage = (event) => {
+                const msg = JSON.parse(event.data);
+
+                if (msg.type === "text_stream_start") {
+                    clearThinkingState();
+                    const msgs = document.getElementById('chat-messages');
+                    activeStreamMessage = document.createElement('div');
+                    activeStreamMessage.className = 'message msg-ai';
+                    activeStreamMessage.style.whiteSpace = 'pre-wrap';
+                    msgs.appendChild(activeStreamMessage);
+                    // Only scroll if already near the bottom to avoid lock
+                    if (msgs.scrollHeight - msgs.scrollTop < msgs.clientHeight + 100) {
+                        msgs.scrollTop = msgs.scrollHeight;
+                    }
+                } else if (msg.type === "text_stream") {
+                    if (activeStreamMessage) {
+                        // Use textContent instead of innerHTML to avoid parsing <think> tags as HTML
+                        activeStreamMessage.textContent += msg.token;
+                        const msgs = document.getElementById('chat-messages');
+                        // Only scroll if already near the bottom
+                        if (msgs.scrollHeight - msgs.scrollTop < msgs.clientHeight + 100) {
+                            msgs.scrollTop = msgs.scrollHeight;
+                        }
+                    }
+                } else if (msg.type === "text_stream_end") {
+                    if (activeStreamMessage) {
+                        chatHistory.push({ role: 'assistant', content: activeStreamMessage.textContent });
+                        activeStreamMessage = null;
+                        document.getElementById('chat-input').disabled = false;
+                        const msgs = document.getElementById('chat-messages');
+                        msgs.scrollTop = msgs.scrollHeight;
+                    }
+                } else {
+                    // Fallback to original handling logic if it's not a stream
+                    if (msg.type === "status") {
+                        logMessage("[STATUS]", msg.message, "#aaa");
+                        setThinkingState(msg.message);
+                    } else if (msg.type === "jules_task") {
+                        logMessage("[JULES]", msg.reasoning || "Task created", "#00bcd4");
+                    } else if (msg.type === "qwen_extract") {
+                        logMessage("[QWEN]", msg.reasoning || "Data extracted", "#e6a23c");
+                    } else if (msg.type === "deepseek_logic") {
+                        logMessage("[DEEPSEEK]", "Executing quant logic...", "#818cf8");
+                    } else if (msg.type === "llama_judge") {
+                        logMessage("[JUDGE]", "Verifying constraints...", "#b8860b");
+                    } else if (msg.type === "result") {
+                        try {
+                            const parsed = JSON.parse(msg.message);
+                            if (parsed.widget) {
+                                // Defer clearThinkingState inside renderWidget
+                                renderWidget(parsed);
+                            } else {
+                                clearThinkingState();
+                                addAIMessage(msg.message);
+                                document.getElementById('chat-input').disabled = false;
+                            }
+                        } catch(e) {
+                            clearThinkingState();
+                            addAIMessage(msg.message);
+                            document.getElementById('chat-input').disabled = false;
+                        }
+                    } else if (msg.type === "execution") {
+                        clearThinkingState();
+                        addAIMessage("Execution Recommended:\n" + JSON.stringify(msg.data, null, 2));
+                        document.getElementById('chat-input').disabled = false;
+                    } else if (msg.type === "error") {
+                        clearThinkingState();
+                        logMessage("[ERROR]", msg.message, "#ff4d4d");
+                        addAIMessage("Error: " + msg.message);
+                        document.getElementById('chat-input').disabled = false;
+                    }
+                }
+            };
+        }
+
+        // Initialize
+        connectWS();
+    </script>
+
+    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
+    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
+    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
+    <script src="https://unpkg.com/lightweight-charts@4.1.1/dist/lightweight-charts.standalone.production.js"></script>
+    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
+    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
+    <script src="/static/js/config.js"></script>
+    <script src="/static/js/fiiTool.js"></script>
+    <script src="/static/js/turtleTab.js"></script>
+    <script src="/static/js/statarbTab.js"></script>
+    <script src="/static/js/layout.js"></script>
+    <script src="/static/js/toolbox.js"></script>
+    <script src="/static/js/edge.js"></script>
+    <script src="/static/js/putCallParity.js"></script>
+    <script src="/static/js/indexBasket.js"></script>
+    <script src="/static/js/specialSitTool.js"></script>
+    <script src="/static/js/chartTabs.js"></script>
+    <script src="/static/js/opt_analysis.js"></script>
+    <script src="/static/js/oiTool.js"></script>
+    <script src="/static/js/rolloverTool.js"></script>
+    <script src="/static/js/workbookManager.js"></script>
+    <script>
+        document.addEventListener('DOMContentLoaded', () => {
+            // Initialize workbook modules so their render() functions work
+            if (typeof WorkbookManager !== 'undefined') {
+                WorkbookManager.init();
+            }
+
+            // Switch to AI tab by default
+            switchClientTab('ai');
+        });
+    </script>
+    <script src="/static/js/exportUtils.js"></script>
+    <script src="/static/js/mwplTool.js"></script>
+    <script src="/static/js/derivArbFund.js"></script>
+    <!-- Removed script_workbench2.js as it runs page initialization breaking the chat UI -->
+
+</body>
+</html>

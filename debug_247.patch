+        return {
+            "data": result_data,
+            "nifty": nifty_data,
+            "date": latest_fo_date.strftime('%Y-%m-%d')
+        }
+
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        raise HTTPException(status_code=500, detail=str(e))

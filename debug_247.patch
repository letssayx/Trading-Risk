+            const res = await fetch('/api/macro/sync', { method: 'POST' });
+            if (!res.ok) throw new Error('Sync failed');
+            await loadMacroData(); // Refresh UI
+        } catch(e) {
+            alert("Error syncing Macro data: " + e.message);
+        } finally {
+            btn.innerHTML = origText;
+            btn.disabled = false;
+        }
+    }
+
+    async function loadMacroData() {
+        try {
+            const res = await fetch('/api/macro/data');
+            if (!res.ok) return;
+            const data = await res.json();
+
+            if (data.date) {
+                const dateElem = document.getElementById('macro-date-display');
+                if (dateElem) dateElem.innerText = `Last Updated: ${data.date}`;
+            }
+
+            // Populate Snapshot
+            const snapBody = document.getElementById('macro-snapshot-body');
+            if (snapBody && data.snapshot) {
+                let html = '';
+                for (const [key, val] of Object.entries(data.snapshot)) {
+                    if (val && typeof val === 'object' && val.price !== undefined) {
+                        const pctColor = val.pct_change >= 0 ? '#60a5fa' : '#f87171';
+                        const sign = val.pct_change > 0 ? '+' : '';
+                        html += `<tr>
+                            <td style="text-transform: capitalize; color: #ccc;">${key.replace('_', ' ')}</td>
+                            <td>${val.price.toFixed(2)}</td>
+                            <td style="color: ${pctColor};">${sign}${val.pct_change.toFixed(2)}%</td>
+                            <td style="color: #aaa; font-size: 11px;">${data.date}</td>
+                        </tr>`;
+                    }
+                }
+                if (html) snapBody.innerHTML = html;
+            }
+
+            // Populate Events
+            const eventsBody = document.getElementById('macro-events-body');
+            if (eventsBody && data.events && data.events.length > 0) {
+                let html = '';
+                data.events.forEach(e => {
+                    const impactColor = e.impact === 'High' ? '#e53e3e' : (e.impact === 'Medium' ? '#ed8936' : '#718096');
+                    html += `<tr>
+                        <td style="color: #aaa; white-space: nowrap;">${e.date}</td>
+                        <td style="color: #ccc;">${e.country}</td>
+                        <td style="font-weight: bold;">${e.event}</td>
+                        <td>${e.actual || '-'}</td>
+                        <td>${e.forecast || '-'}</td>
+                        <td style="color: ${impactColor}; text-align: center;">${e.impact}</td>
+                    </tr>`;
+                });
+                eventsBody.innerHTML = html;
+            } else if (eventsBody) {
+                eventsBody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #888;">No high impact events today.</td></tr>';
+            }
+        } catch(e) {
+            console.error("Failed to load macro data", e);
+        }
+    }
+</script>
+</body>
+</html>

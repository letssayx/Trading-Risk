+async function reparseHistoricalDividends() {
+    if (!confirm("This will incrementally scan the database and attempt to extract dividend amounts for historical records that are currently missing them. Continue?")) return;
+
+    try {
+        const res = await fetch('/api/data/dividends/patch', { method: 'POST' });
+        if (res.ok) {
+            const data = await res.json();
+            alert(`Success: ${data.updated_count} historical dividend records were updated! You can now click Load Data to see the fixed values.`);
+        } else {
+            alert('Failed to reparse dividends.');
+        }
+    } catch (e) {
+        console.error(e);
+        alert('An error occurred while patching the database.');
+    }
+}
+
+async function syncDividendsData() {
+    const syncBtn = document.querySelector('button[onclick="syncDividendsData()"]');
+    if (syncBtn) {
+        syncBtn.disabled = true;
+        syncBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Syncing...';
+    }
+
+    try {
+        const force = document.getElementById('forceRebuildDatabank')?.checked || false;
+        const res = await fetch(`/api/data/dividends/build-databank?force=${force}`, { method: 'POST' });
+        if (res.ok) {
+            alert('Sync task triggered in the background. It will optimize and rebuild the latest data. Please click "Load Database Data" after a few seconds.');
+        } else {
+            alert('Failed to trigger sync task.');
+        }
+    } catch (e) {
+        console.error(e);
+        alert('Error triggering sync task.');
+    } finally {
+        if (syncBtn) {
+            syncBtn.disabled = false;
+            syncBtn.innerHTML = '<i class="fas fa-sync"></i> Sync Latest';

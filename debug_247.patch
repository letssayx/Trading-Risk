+
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        raise HTTPException(500, f"Error processing file: {str(e)}")
+    finally:
+        if os.path.exists(tmp_path): os.unlink(tmp_path)
+        if csv_path and os.path.exists(csv_path): os.unlink(csv_path)

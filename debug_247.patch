+    });
+
+    async function loadOptionChain() {
+        const sym = document.getElementById('opt-symbol-input').value.toUpperCase();
+        if (!sym) return;
+
+        const loadBtn = document.getElementById('btn-load-option-chain');
+        let originalText = '';
+        if (loadBtn) {
+            originalText = loadBtn.innerHTML;
+            loadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
+            loadBtn.disabled = true;
+        }
+
+        const expirySelect = document.getElementById('opt-expiry-select');
+        const selectedExpiry = expirySelect.value;
+        const tbody = document.getElementById('option-chain-body');
+
+        tbody.innerHTML = '<tr><td colspan="21" style="text-align:center; color:#888;">Loading...</td></tr>';
+
+        try {
+            let url = `/api/data/derivatives/option_chain?symbol=${sym}`;
+            if (selectedExpiry) url += `&expiry=${selectedExpiry}`;
+
+            const res = await fetch(url);
+            let data = null;
+            try {
+                data = await res.json();
+            } catch (jsonErr) {
+                if (!res.ok) throw new Error(await res.text());
+                throw new Error("Invalid JSON response from server.");
+            }
+
+            if (!res.ok) {
+                const errMsg = data.detail || await res.text();
+                throw new Error(errMsg);
+            }
+
+            // Populate expiries dropdown if empty or different symbol
+            if (data && data.expiries && data.expiries.length > 0) {
+                expirySelect.style.display = 'block';
+                // Only rebuild dropdown if we don't have this list already to preserve user selection
+                const currentExpiries = Array.from(expirySelect.options).map(o => o.value);
+                if (currentExpiries.join(',') !== data.expiries.join(',')) {
+                    expirySelect.innerHTML = '';
+                    data.expiries.forEach(exp => {
+                        const opt = document.createElement('option');
+                        opt.value = exp;
+                        opt.innerText = exp;
+                        if (exp === data.selected_expiry) opt.selected = true;
+                        expirySelect.appendChild(opt);

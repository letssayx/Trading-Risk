+<!DOCTYPE html>
+<html>
+<head>
+    <meta charset="utf-8">
+    <title>Institutional Derivatives Report - {{ date }}</title>
+    <style>
+        @page { size: A4 landscape; margin: 1cm; }
+        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #1a202c; }
+        h1 { color: #2d3748; border-bottom: 2px solid #2b6cb0; padding-bottom: 5px; font-size: 18px; margin-top: 0;}
+        h2 { color: #2b6cb0; border-bottom: 1px solid #e2e8f0; font-size: 14px; margin-top: 20px;}
+        h3 { color: #4a5568; font-size: 12px; margin-bottom: 5px; }
+        table { width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 9px; page-break-inside: avoid; }
+        th, td { border: 1px solid #e2e8f0; padding: 4px; text-align: right; }
+        th { background-color: #edf2f7; color: #4a5568; font-weight: bold; text-align: center; }
+        .text-left { text-align: left; }
+        .text-center { text-align: center; }
+        .highlight-green { color: #38a169; font-weight: bold; }
+        .highlight-red { color: #e53e3e; font-weight: bold; }
+        .summary-box { background-color: #f7fafc; border-left: 4px solid #2b6cb0; padding: 10px; margin: 10px 0; font-size: 10px; }
+        .ai-box { background-color: #ebf8ff; border-left: 4px solid #3182ce; padding: 10px; margin: 10px 0; font-style: italic; font-size: 10px; }
+        .page-break { page-break-after: always; }
+        .grid-container { display: table; width: 100%; margin-bottom: 20px; }
+        .grid-row { display: table-row; }
+        .grid-col { display: table-cell; padding: 5px; width: 20%; text-align: center; vertical-align: top; }
+        .chart-img { max-width: 100%; height: auto; border: 1px solid #e2e8f0; }
+        .footer-note { font-size: 8px; color: #718096; margin-top: 20px; font-style: italic; border-top: 1px solid #e2e8f0; padding-top: 5px; }
+    </style>
+</head>
+<body>
+    <!-- PAGE 1: EXECUTIVE DASHBOARD -->
+    <h1>Institutional Derivatives Report - {{ date }}</h1>
+    {% if date_fallback_note %}
+    <div class="summary-box" style="border-left-color: #e53e3e; background-color: #fff5f5; color: #c53030;">
+        <strong>{{ date_fallback_note }}</strong>
+    </div>
+    {% endif %}
+
+    <div class="summary-box">
+                <h3>Quantitative Market Read & FII Flow</h3>
+        {% if fii_stats %}
+        <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px;">
+            <thead>
+                <tr style="background-color: #f7fafc; color: #4a5568;">
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: left;">Metric</th>
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">Value</th>
+                </tr>
+            </thead>
+            <tbody>
+                <tr>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0;">FII Index Futures Longs</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: right; color: #3182ce;">{{ fii_stats.idx_long }}</td>
+                </tr>
+                <tr>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0;">FII Index Futures Shorts</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: right; color: #e53e3e;">{{ fii_stats.idx_short }}</td>
+                </tr>
+                <tr>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0;">FII Index Futures L/S Ratio</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">
+                        {% if fii_stats.idx_short > 0 %}
+                            {{ "%.2f"|format(fii_stats.idx_long / fii_stats.idx_short) }}
+                        {% else %}
+                            N/A
+                        {% endif %}
+                    </td>
+                </tr>
+                <tr>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0;">FII Index Options Call Net</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">{{ fii_stats.call_net }}</td>
+                </tr>
+                <tr>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0;">FII Index Options Put Net</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">{{ fii_stats.put_net }}</td>
+                </tr>
+            </tbody>
+        </table>
+        {% endif %}
+        <div style="margin-top: 15px; padding: 10px; background-color: #f7fafc; border-left: 3px solid #3182ce; font-size: 11px;">
+            {{ quant_summary | replace('\n', '<br>') | safe }}
+        </div>
+    </div>
+
+    <div class="ai-box">
+        <h3>AI Executive Summary</h3>
+        <p>{{ ai_inference | replace('\n', '<br>') | safe }}</p>
+    </div>
+
+
+    {% if is_expiry_eve %}
+    <div class="page-break"></div>
+
+    <!-- DEDICATED EXPIRY PAGE -->
+    <h1>Expiry Eve Analysis (DTE <= 1)</h1>
+
+    <div class="grid-container" style="margin-bottom: 20px;">
+        <div class="grid-row" style="display: flex; gap: 20px;">
+            {% if mwpl_data %}
+            <div class="summary-box" style="flex: 1; border-left-color: #e53e3e;">
+                <h3>Top 5 High MWPL Stocks (Ban Risk)</h3>
+                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
+                    <thead>
+                        <tr style="background-color: #f7fafc; color: #4a5568;">
+                            <th style="padding: 6px; border: 1px solid #e2e8f0; text-align: left;">Symbol</th>
+                            <th style="padding: 6px; border: 1px solid #e2e8f0; text-align: right;">MWPL %</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        {% for item in mwpl_data %}
+                        <tr>
+                            <td style="padding: 6px; border: 1px solid #e2e8f0; font-weight: bold;">{{ item.symbol }}</td>
+                            <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: right; color: {% if item.mwpl_pct >= 95 %}#e53e3e{% elif item.mwpl_pct >= 85 %}#ed8936{% else %}#718096{% endif %};">{{ "%.2f"|format(item.mwpl_pct) }}%</td>
+                        </tr>
+                        {% endfor %}
+                    </tbody>
+                </table>
+            </div>
+            {% endif %}
+
+            {% if rollover_data %}
+            <div class="summary-box" style="flex: 1; border-left-color: #3182ce;">
+                <h3>Top 5 High Rollover Activity</h3>
+                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
+                    <thead>
+                        <tr style="background-color: #f7fafc; color: #4a5568;">
+                            <th style="padding: 6px; border: 1px solid #e2e8f0; text-align: left;">Symbol</th>
+                            <th style="padding: 6px; border: 1px solid #e2e8f0; text-align: right;">Rollover %</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        {% for item in rollover_data %}
+                        <tr>
+                            <td style="padding: 6px; border: 1px solid #e2e8f0; font-weight: bold;">{{ item.symbol }}</td>
+                            <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: right; color: #3182ce;">{{ "%.2f"|format(item.rollover_pct) }}%</td>
+                        </tr>
+                        {% endfor %}
+                    </tbody>
+                </table>
+            </div>
+            {% endif %}
+        </div>
+    </div>
+
+
+    <div class="summary-box" style="border-left-color: #ed8936; background-color: #fffaf0;">
+        <h3>Index Expiry Dynamics</h3>
+        <table style="margin-bottom: 0;">
+            <tr>
+                <th class="text-left">Index</th>
+                <th>Estimated ATM</th>
+                <th>ATM Straddle Prem</th>
+                <th>Upper Bound Break</th>
+                <th>Lower Bound Break</th>
+            </tr>
+            {% for symbol, data in expiry_eve_data.items() %}
+            <tr>
+                <td class="text-left"><strong>{{ symbol }}</strong></td>
+                <td>{{ "%.0f"|format(data.atm) }}</td>
+                <td>{{ "%.1f"|format(data.straddle) }}</td>
+                <td class="highlight-green">{{ "%.0f"|format(data.upper_bound) }}</td>
+                <td class="highlight-red">{{ "%.0f"|format(data.lower_bound) }}</td>
+            </tr>
+            {% endfor %}
+        </table>
+        <p style="margin-top: 10px; font-size: 9px; color: #718096;">
+            <em>* Note: Upper and lower bounds represent the implied 1-standard deviation move priced in by the ATM straddle premium for the nearest expiry.</em>
+        </p>
+    </div>
+    {% endif %}
+
+
+    {% if macro_events %}
+    <div class="summary-box" style="margin-top: 20px;">
+        <h3>Macro & Economic Events</h3>
+        <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px;">
+            <thead>
+                <tr style="background-color: #f7fafc; color: #4a5568;">
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: left;">Date</th>
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: left;">Country</th>
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: left;">Event</th>
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">Actual</th>
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">Forecast</th>
+                    <th style="padding: 8px; border: 1px solid #e2e8f0; text-align: center;">Impact</th>
+                </tr>
+            </thead>
+            <tbody>
+                {% for event in macro_events %}
+                <tr>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0;">{{ event.date }}</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0;">{{ event.country }}</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; font-weight: bold;">{{ event.event }}</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">{{ event.actual }}</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: right;">{{ event.forecast }}</td>
+                    <td style="padding: 8px; border: 1px solid #e2e8f0; text-align: center; color: {% if event.impact == 'High' %}#e53e3e{% elif event.impact == 'Medium' %}#ed8936{% else %}#718096{% endif %};">{{ event.impact }}</td>
+                </tr>
+                {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    {% endif %}
+
+    <div class="page-break"></div>
+
+    <!-- PAGE 2: TREND CHARTS (LONG/SHORT) -->
+    <h1>5-Day Action: Price vs OI Action</h1>
+
+    <h3>Top 5 Long Buildup (OI + Price Increase)</h3>
+    <div class="grid-container">
+        <div class="grid-row">
+            {% for chart in long_charts %}
+            <div class="grid-col">
+                <img src="file://{{ chart.path }}" class="chart-img">
+            </div>
+            {% endfor %}
+        </div>
+    </div>
+
+    <h3>Top 5 Short Buildup (OI + Price Decrease)</h3>
+    <div class="grid-container">
+        <div class="grid-row">
+            {% for chart in short_charts %}
+            <div class="grid-col">
+                <img src="file://{{ chart.path }}" class="chart-img">
+            </div>
+            {% endfor %}
+        </div>
+    </div>
+
+    <div class="page-break"></div>
+

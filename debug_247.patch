+@router.post("/ingest/import/force-kill/{task_id}")
+async def force_kill_import_task(task_id: str):
+    """
+    Forcefully Terminate a running Celery import task.
+    """
+    import os
+    import redis
+    from backend.celery_worker import app as celery_app
+    try:
+        redis_url = os.getenv("REDIS_URL", "redis://localhost:6379/0")
+        r = redis.from_url(redis_url)
+
+        # 1. Clear active tracking
+        active = r.get("active_import_task_id")
+        if active and active.decode('utf-8') == task_id:
+            r.delete("active_import_task_id")
+
+        # 2. Clear all queues to prevent zombie tasks from restarting when worker comes back
+        r.delete("celery")
+        r.delete("unacked")
+        r.delete("unacked_index")
+
+        # 3. Because pool=solo doesn't support revoke(terminate=True), we must use OS-level kill.
+        # This will kill the worker entirely, requiring it to be restarted manually or by a process manager.
+        os.system("pkill -9 -f celery")
+
+        # Also try standard revoke just in case
+        celery_app.control.revoke(task_id, terminate=False)
+
+        return {"success": True, "message": f"Task {task_id} forcefully terminated by killing worker. Please restart Celery."}
+    except Exception as e:
+        logger.error(f"Failed to force kill task {task_id}: {e}")

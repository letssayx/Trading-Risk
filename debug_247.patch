+                               .first()
+        if not latest_fo_date_row:
+            return {"data": {}, "nifty": None}
+        latest_fo_date = latest_fo_date_row[0]
+
+        # 2. Add NIFTY to symbols list if not present
+        query_symbols = [s.upper() for s in symbols]
+        if "NIFTY" not in query_symbols:

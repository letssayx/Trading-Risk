+    }
+}
+
+async function loadDividendsData(forcedSymbol = null) {
+    const loadBtn = document.querySelector('button[onclick="loadDividendsData()"]');
+    const originalHtml = loadBtn ? loadBtn.innerHTML : '';
+    if (loadBtn) {
+        loadBtn.disabled = true;
+        loadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
+    }
+
+    try {
+        const endDate = new Date().toISOString().split('T')[0];
+
+        const searchInput = document.getElementById('div-symbol-search');
+        let symbolVal = forcedSymbol;
+        if (!symbolVal) symbolVal = searchInput ? searchInput.value.trim() : '';
+        const symbolQuery = symbolVal ? `&symbol=${symbolVal.toUpperCase()}` : '';
+
+        const startInput = document.getElementById('div-start-date');
+        const endInput = document.getElementById('div-end-date');
+        const startDate = startInput && startInput.value ? `&start_date=${startInput.value}` : '';
+        const endQueryDate = endInput && endInput.value ? `&end_date=${endInput.value}` : '';
+
+        // Do NOT auto-clear symbol search so user can see what they filtered
+        // if (searchInput) searchInput.value = '';
+
+        document.getElementById('div-actions-table').querySelector('tbody').innerHTML = '<tr><td colspan="10" style="text-align:center;">Loading...</td></tr>';
+
+        // Set limit to 0 (unlimited) if no date range is provided to fetch all historical data
+        const hasDateRange = startDate || endQueryDate;
+        const limitQuery = hasDateRange ? '&limit=100000' : (symbolVal ? '&limit=0' : '&limit=5000');
+
+        const foCheckbox = document.getElementById('div-fo-only-filter');
+        const foQuery = foCheckbox && foCheckbox.checked ? '&fo_only=true' : '';
+
+        // Fetch dividends
+        let dbActionsRes = await fetch(`/api/data/view/list?type=dividend${limitQuery}${symbolQuery}${foQuery}${startDate}${endQueryDate}`);
+        let dbActions = await dbActionsRes.json();
+
+        // Always trust the database. If it's empty, we legitimately have no data for that symbol.
+        let actions = Array.isArray(dbActions) ? dbActions : (dbActions.data || []);
+
+        // Fetch board meetings to join
+        let dbMeetingsRes = await fetch(`/api/data/view/list?type=board_meeting${limitQuery}${symbolQuery}${foQuery}${startDate}${endQueryDate}`);
+        let dbMeetings = await dbMeetingsRes.json();
+
+        const meetingsArray = Array.isArray(dbMeetings) ? dbMeetings : (dbMeetings.data || []);
+        if (meetingsArray.length > 0) {
+             divMeetingsData = meetingsArray;
+             divMeetingsData.sort((a, b) => new Date(b.meeting_date || b.date) - new Date(a.meeting_date || a.date));
+        } else {
+             divMeetingsData = [];
+        }
+
+        // Store fetched dividend data globally
+        window.divRawData = actions;
+        divRawData = actions; // Also update the global variable properly
+
+        renderDividendsData();
+    } catch(err) {
+        console.error("Error loading dividends data", err);
+        // Ensure UI doesn't hang in "Loading..." state on failure
+        document.getElementById('div-actions-table').querySelector('tbody').innerHTML = `<tr><td colspan="10" style="text-align:center; color:red;">Error loading data: ${err.message}</td></tr>`;
+    } finally {
+        const loadBtn = document.querySelector('button[onclick="loadDividendsData()"]');
+        if (loadBtn) {
+            loadBtn.disabled = false;
+            loadBtn.innerHTML = '<i class="fas fa-database"></i> Load Database Data';
+        }
+    }
+}
